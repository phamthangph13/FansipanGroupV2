# Site
NEXT_PUBLIC_SITE_URL=https://fansipan-group.vn

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/fansipan_group
MONGODB_DB=fansipan_group

# Admin authentication (bắt buộc đặt khi production)
# Dev: để trống ADMIN_PASSWORD sẽ dùng mật khẩu mặc định fansipan2026.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Hidden administrator login URL (no leading slash). Change this in production.
ADMIN_LOGIN_PATH=quan-tri-v2

# Salt used to anonymise visitor identifiers for the analytics dashboard.
ANALYTICS_SALT=

# SMTP configuration for contact & recruitment emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FANSIPAN GROUP" <no-reply@fansipan-group.vn>

# Mail recipients
MAIL_TO=contact@fansipan-group.vn
CAREERS_MAIL_TO=tuyendung@fansipan-group.vn
